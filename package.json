{
  "name": "air-flutter",
  "displayName": "Air Flutter: Wireless ADB, Screen Mirror & Logcat for Flutter",
  "description": "The complete Flutter & Android engineering suite: compatibility doctor & auto-fixer (Gradle, AGP, Java, iOS), wireless ADB, scrcpy screen mirroring, live logcat, screen recording for PRs, network proxy & Private DNS, Flutter Flavors, MCP & AI Agent Hub, AI sub-agent scaffolding & GitHub Actions CI/CD workflows.",
  "version": "3.0.0",
  "publisher": "ahmedshaban",
  "author": {
    "name": "Ahmed Shaban",
    "url": "https://ahmed-shaban-dev.vercel.app"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmedshaban-blip/air-flutter"
  },
  "homepage": "https://github.com/ahmedshaban-blip/air-flutter#readme",
  "bugs": {
    "url": "https://github.com/ahmedshaban-blip/air-flutter/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#14150F",
    "theme": "dark"
  },
  "categories": [
    "Debuggers",
    "Programming Languages",
    "Testing",
    "Other"
  ],
  "keywords": [
    "flutter",
    "dart",
    "android",
    "wireless adb",
    "wireless debugging",
    "adb over wifi",
    "air flutter",
    "screen mirroring",
    "screen mirror",
    "mirror android",
    "scrcpy",
    "phone screen off",
    "logcat",
    "logcat viewer",
    "device log",
    "android log",
    "screenshot",
    "flutter run",
    "hot reload",
    "apk",
    "aab",
    "build apk",
    "flutter doctor",
    "device management",
    "usb debugging",
    "debug android",
    "mobile development",
    "emulator",
    "connected device",
    "adb",
    "flutter flavors",
    "flavors",
    "screen recording",
    "mp4",
    "network proxy",
    "proxy",
    "charles proxy",
    "proxyman",
    "private dns",
    "dns over tls",
    "github actions",
    "ci cd",
    "ai agents",
    "subagents",
    "antigravity",
    "mcp",
    "model context protocol",
    "mcp servers",
    "ai agent hub",
    "cursor",
    "cline",
    "roo code",
    "windsurf",
    "copilot",
    "claude desktop",
    "codex"
  ],
  "main": "./out/main.js",
  "scripts": {
    "vscode:prepublish": "npm run setup && npm run build:sidebar-css && npm run compile",
    "setup": "npm install",
    "build:sidebar-css": "node scripts/build-sidebar-css.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run clean && npm run compile && npm run package",
    "clean": "rimraf out dist",
    "package": "vsce package",
    "test:mcp": "tsc -p ./ && tsc -p tsconfig.test-mcp.json && node test-build/test/test-mcp-hub.js && node test/test-mcp-companion.js && node test/test-mcp-dom.js && node test/test-mcp-panel-button.js && node test/test-mcp-loadorder.js",
    "test:workflow": "tsc -p ./ && node test/test-workflow-generator.js && node test/test-workflow-dom.js",
    "test:vsix": "node test/test-mcp-vsix.js && node test/test-mcp-loadorder-vsix.js"
  },
  "dependencies": {
    "adm-zip": "^0.4.14",
    "diff": ">=3.5.0",
    "js-yaml": "^4.3.2",
    "local-devices": "^3.0.0",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.32.0",
    "jsdom": "^30.1.3",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "activationEvents": [
    "onView:air-flutter-panel",
    "onStartupFinished"
  ],
  "contributes": {
    "contexts": [
      {
        "id": "workspaceHasAirFlutter",
        "description": "True when the workspace contains a Flutter project",
        "default": false
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "air-flutter-sidebar",
          "title": "Air Flutter",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "air-flutter-sidebar": [
        {
          "id": "air-flutter-panel",
          "name": "Air Flutter",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "airFlutter.openFlutterPanel",
        "title": "Open Air Flutter Panel",
        "category": "Air Flutter",
        "icon": "$(open-preview)"
      },
      {
        "command": "airFlutter.connectWirelessDevice",
        "title": "Connect Wireless Device",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.showConnectedDevices",
        "title": "Show Connected Devices",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.showTroubleshootingGuide",
        "title": "Device Setup Guide",
        "category": "Air Flutter",
        "icon": "$(tools)"
      },
      {
        "command": "airFlutter.runFlutterDoctor",
        "title": "Flutter Doctor",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.getPackages",
        "title": "Get Packages",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.upgradePackages",
        "title": "Upgrade Packages",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.cleanProject",
        "title": "Clean Project",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.runFlutterApp",
        "title": "Run Flutter App",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.buildAPK",
        "title": "Build APK",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.buildAppBundle",
        "title": "Build App Bundle (AAB)",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.killserver",
        "title": "Kill ADB Server",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.enableFirebaseDebug",
        "title": "Enable Firebase Debug",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.disableFirebaseDebug",
        "title": "Disable Firebase Debug",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.startScreenMirroring",
        "title": "Start Screen Mirroring",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.mirrorWithScreenOff",
        "title": "Mirror With Phone Screen Off",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.mirrorWithKeyboard",
        "title": "Mirror With Phone Screen Off and Hardware Keyboard",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.mirrorWirelessDisplay",
        "title": "Mirror Into Virtual Display (Phone Off)",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.setScrcpyPath",
        "title": "Select scrcpy Executable",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.stopScreenMirroring",
        "title": "Stop Screen Mirroring",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.wakeScreen",
        "title": "Wake Device Screen",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.toggleScreenPower",
        "title": "Toggle Mirrored Device Display",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.installApk",
        "title": "Install APK to Device",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.sendTextToDevice",
        "title": "Send Text / Clipboard to Device",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.generateWorkflow",
        "title": "Generate GitHub Actions CI/CD Workflow",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.openSigningKeyModal",
        "title": "Create Android Signing Key",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.openFlavorsModal",
        "title": "Manage & Build Flutter Flavors",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.openProxyModal",
        "title": "Configure Network Proxy & Private DNS",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.toggleScreenRecording",
        "title": "Record Screen (MP4) to Workspace",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.openAgentScaffoldingModal",
        "title": "AI Agent Architect & Scaffolding Engine",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.runCompatDoctor",
        "title": "Flutter Compatibility Doctor",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.upgradeBuildStack",
        "title": "Upgrade Flutter Build Stack (Auto-Fixer)",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.resetAppState",
        "title": "Reset App State (Cache, Database, Factory)",
        "category": "Air Flutter",
        "icon": "$(history)"
      },
      {
        "command": "airFlutter.clearAppCache",
        "title": "Clear App Cache Only",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.resetAppDatabases",
        "title": "Reset App Databases Only",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.factoryResetApp",
        "title": "Factory Reset App (pm clear)",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.packageBugReport",
        "title": "Package Bug Report (Screenshot + Logs)",
        "category": "Air Flutter",
        "icon": "$(bug)"
      },
      {
        "command": "airFlutter.openMcpHub",
        "title": "MCP & AI Agent Hub",
        "category": "Air Flutter",
        "icon": "$(server-process)"
      },
      {
        "command": "airFlutter.openMcpHubWizard",
        "title": "MCP & AI Agent Hub (Quick Wizard)",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.showMcpCatalog",
        "title": "Browse MCP Server Catalog",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.checkMcpPrerequisites",
        "title": "Check MCP Prerequisites",
        "category": "Air Flutter"
      },
      {
        "command": "airFlutter.cleanCommentedCode",
        "title": "Clean Commented-Out Dart Code (Detect, Remove, Uncomment)",
        "category": "Air Flutter",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "airFlutter.cleanCommentedCode",
          "when": "workspaceHasAirFlutter"
        },
        {
          "command": "airFlutter.runCompatDoctor",
          "when": "workspaceHasAirFlutter"
        },
        {
          "command": "airFlutter.upgradeBuildStack",
          "when": "workspaceHasAirFlutter"
        },
        {
          "command": "airFlutter.resetAppState",
          "when": "workspaceHasAirFlutter"
        },
        {
          "command": "airFlutter.clearAppCache",
          "when": "workspaceHasAirFlutter"
        },
        {
          "command": "airFlutter.resetAppDatabases",
          "when": "workspaceHasAirFlutter"
        },
        {
          "command": "airFlutter.factoryResetApp",
          "when": "workspaceHasAirFlutter"
        },
        {
          "command": "airFlutter.packageBugReport",
          "when": "workspaceHasAirFlutter"
        },
        {
          "command": "airFlutter.openFlutterPanel",
          "when": "workspaceHasAirFlutter"
        },
        {
          "command": "airFlutter.connectWirelessDevice",
          "when": "workspaceHasAirFlutter"
        },
        {
          "command": "airFlutter.showConnectedDevices",
          "when": "workspaceHasAirFlutter"
        },
        {
          "command": "airFlutter.showTroubleshootingGuide",
          "when": "workspaceHasAirFlutter"
        },
        {
          "command": "airFlutter.killserver",
          "when": "workspaceHasAirFlutter"
        },
        {
          "command": "airFlutter.openMcpHub",
          "when": "workspaceHasAirFlutter"
        }
      ],
      "view/title": [
        {
          "command": "airFlutter.openFlutterPanel",
          "when": "view == air-flutter-panel",
          "group": "navigation"
        },
        {
          "command": "airFlutter.packageBugReport",
          "when": "view == air-flutter-panel && workspaceHasAirFlutter",
          "group": "navigation@2"
        },
        {
          "command": "airFlutter.openMcpHub",
          "when": "view == air-flutter-panel && workspaceHasAirFlutter",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Air Flutter",
      "properties": {
        "airFlutter.adbPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to ADB executable"
        },
        "airFlutter.flutterPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to Flutter executable"
        },
        "airFlutter.defaultBuildMode": {
          "type": "string",
          "enum": [
            "debug",
            "profile",
            "release"
          ],
          "default": "debug",
          "description": "Default build mode for APK/AAB builds"
        },
        "airFlutter.scrcpyPath": {
          "type": "string",
          "default": "",
          "description": "Path to the scrcpy executable used for screen mirroring"
        },
        "airFlutter.mirroringMaxSize": {
          "type": "number",
          "default": 1600,
          "minimum": 640,
          "maximum": 3840,
          "description": "Maximum mirrored video dimension; lower values reduce wireless latency"
        },
        "airFlutter.mirroringMaxFps": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "maximum": 120,
          "description": "Maximum screen mirroring frame rate"
        },
        "airFlutter.mirroringVideoBitRate": {
          "type": "string",
          "default": "6M",
          "pattern": "^[1-9][0-9]*(K|M)?$",
          "description": "scrcpy video bit rate, for example 4M or 8M"
        },
        "airFlutter.mirroringAudio": {
          "type": "boolean",
          "default": false,
          "description": "Forward device audio while mirroring; disabled by default for lower latency"
        },
        "airFlutter.mcp.backupBeforeWrite": {
          "type": "boolean",
          "default": true,
          "description": "Create a timestamped backup next to an AI agent MCP config file before the MCP & AI Agent Hub modifies it"
        }
      }
    }
  }
}