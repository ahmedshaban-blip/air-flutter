  "availableVersions": {
    "agp": ["8.5.2", "8.4.2", "8.3.2", "8.2.2", "8.1.4", "8.0.2", "7.4.2"],
    "gradle": ["8.7", "8.6", "8.5", "8.4", "8.2.1", "8.0.2", "7.6.4", "7.5"],
    "kotlin": ["1.9.24", "1.9.10", "1.8.22", "1.7.20"],
