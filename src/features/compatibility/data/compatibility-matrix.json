{
  "$schema": "./compatibility-schema.json",
  "version": "1.0.0",
  "lastUpdated": "2026-10",
  "android": {
    "recommended": {
      "agp": "8.5.2",
      "gradle": "8.7",
      "java": 17,
      "kotlin": "1.9.24"
    },
    "rules": [
      {
        "agpRange": ">=8.5.0 <8.6.0",
        "compatibleGradle": ">=8.7",
        "minJava": 17,
        "recommendedGradle": "8.7",
        "description": "AGP 8.5.x requires Gradle 8.7+ and JDK 17+",
        "migrationUrl": "https://developer.android.com/build/releases/gradle-plugin#updating-gradle"
      },
      {
        "agpRange": ">=8.2.0 <8.5.0",
        "compatibleGradle": ">=8.2 <=8.7",
        "minJava": 17,
        "recommendedGradle": "8.4",
        "description": "AGP 8.2-8.4 requires Gradle 8.2+ and JDK 17+",
        "migrationUrl": "https://developer.android.com/build/releases/gradle-plugin#updating-gradle"
      },
      {
        "agpRange": ">=8.0.0 <8.2.0",
        "compatibleGradle": ">=8.0 <=8.4",
        "minJava": 17,
        "recommendedGradle": "8.1",
        "description": "AGP 8.0-8.1 requires Gradle 8.0+ and JDK 17+",
        "migrationUrl": "https://developer.android.com/build/releases/gradle-plugin#updating-gradle"
      },
      {
        "agpRange": ">=7.4.0 <8.0.0",
        "compatibleGradle": ">=7.5 <=7.6",
        "minJava": 11,
        "recommendedGradle": "7.5",
        "description": "AGP 7.4.x requires Gradle 7.5+ and JDK 11+",
        "migrationUrl": "https://developer.android.com/build/releases/gradle-plugin#updating-gradle"
      },
      {
        "agpRange": ">=7.0.0 <7.4.0",
        "compatibleGradle": ">=7.0 <=7.4",
        "minJava": 11,
        "recommendedGradle": "7.3.3",
        "description": "AGP 7.0-7.3 requires Gradle 7.0-7.4 and JDK 11+",
        "migrationUrl": "https://developer.android.com/build/releases/gradle-plugin#updating-gradle"
      }
    ]
  },
  "ios": {
    "recommended": {
      "minDeploymentTarget": "13.0"
    },
    "deprecatedTargets": ["11.0", "12.0"],
    "description": "Flutter 3.x and modern plugins recommend iOS deployment target 13.0 or higher.",
    "migrationUrl": "https://docs.flutter.dev/reference/supported-platforms"
  }
}

